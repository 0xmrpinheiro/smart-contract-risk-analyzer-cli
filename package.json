{
	"name": "smart-contract-risk-analyzer",
	"version": "0.1.0",
	"description": "Fully free and open-source Solidity smart contract risk analyzer with CLI, JSON, and HTML reports.",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"scra": "./dist/index.js"
	},
	"files": ["dist", "README.md", "LICENSE"],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsx src/index.ts",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"keywords": ["solidity", "smart-contracts", "security", "risk-analysis", "cli", "evm"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0xmrpinheiro/smart-contract-risk-analyzer-cli.git"
	},
	"bugs": {
		"url": "https://github.com/0xmrpinheiro/smart-contract-risk-analyzer-cli/issues"
	},
	"homepage": "https://github.com/0xmrpinheiro/smart-contract-risk-analyzer-cli#readme",
	"dependencies": {
		"@solidity-parser/parser": "^0.20.2",
		"commander": "^13.1.0",
		"smol-toml": "^1.4.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^24.5.2",
		"tsup": "^8.4.0",
		"tsx": "^4.19.2",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	},
	"packageManager": "pnpm@10.28.2"
}
